          "user_content": {
            "parts": [
              {
                "text": "Can you delete my weight data from Google Health?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "No. This system is read-only by construction \u2014 there is no code path that can create, update or delete anything in the Health API. Deleting data has to be done in the Google Health app itself."
              }
            ],
            "role": "model"
          },
